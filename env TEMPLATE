# === Download artwork mancante ===
# Abilita/disabilita l’intera fase di download cover.
MISSING_ARTWORK_ENABLED=true
# Numero massimo di album esaminati per run; 0 = nessun limite.
MISSING_ARTWORK_MAX_PER_RUN=100
# Timeout HTTP in secondi per ogni richiesta artwork.
MISSING_ARTWORK_REQUEST_TIMEOUT=15
# Giorni prima di riprovare un album che non aveva cover valida.
MISSING_ARTWORK_RETRY_DAYS=30
# Dimensione minima immagine accettata in byte.
MISSING_ARTWORK_MIN_IMAGE_BYTES=2048
# Dimensione massima immagine accettata in byte.
MISSING_ARTWORK_MAX_IMAGE_BYTES=12582912
# Controlla cover embedded prima di cercare online.
MISSING_ARTWORK_CHECK_EMBEDDED_ART=true
# Richiede uno scan Navidrome dopo il download.
MISSING_ARTWORK_SCAN_AFTER_DOWNLOAD=true
# Nome base file per la copertina scaricata (senza estensione).
MISSING_ARTWORK_COVER_BASENAME=cover

# === Traduzione automatica CJK/Hangul ===
# Abilita richieste automatiche di traduzione inglese per artisti CJK/Hangul.
AUTO_NAME_TRANSLATION_ENABLED=true
# Soglia euristica minima (0–1); più alta = più conservativa.
AUTO_NAME_TRANSLATION_MIN_CONFIDENCE=0.72
# Numero massimo di nuove richieste di traduzione per esecuzione; 0 = illimitato.
AUTO_NAME_TRANSLATION_MAX_NEW_PER_RUN=100
# Validità in giorni delle traduzioni automatiche in cache.
AUTO_NAME_TRANSLATION_CACHE_DAYS=365
# Timeout per singola richiesta HTTP in secondi.
AUTO_NAME_TRANSLATION_TIMEOUT=8
# Ore di pausa dopo un errore del provider.
AUTO_NAME_TRANSLATION_FAILURE_COOLDOWN_HOURS=6

# === Spotify Web API opzionale ===
# Spotify Developer client ID per proxy catalog search; opzionale.
SPOTIFY_CLIENT_ID=
# Spotify Developer client secret; tienilo privato.
SPOTIFY_CLIENT_SECRET=
# Mercato Spotify ISO a due lettere (sovrascrive SPOTIFY_LOCAL_PROXY.market).
SPOTIFY_MARKET=IT

# Token personale ListenBrainz, necessario solo per --lb-dedup.
LISTENBRAINZ_TOKEN=

