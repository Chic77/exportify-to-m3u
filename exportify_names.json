// Configurazione utente exportify_to_m3u.py. Sono supportati commenti // e /* ... */.
{
  // Traduzione inglese o nome latino ufficiale; precede NAME_FIXES e la romanizzazione automatica.
  "NAME_TRANSLATIONS": {
    // Nome originale -> nome inglese/latino ufficiale, usato per matching e ricerca.
    
  },
  // Alias o romanizzazione manuale per artisti e titoli; corregge letture automatiche errate.
  "NAME_FIXES": {
    // Nome originale -> alias/romanizzazione corretta manualmente.
    
  },
  // Mappa esatta e lossless alias -> forma da scrivere; conserva parentesi/gloss CJK e puo’ dividere crediti con punto e virgola.
  "ARTIST_CANONICAL_NAMES": {
    // Grafia esatta in ingresso -> forma canonica da mantenere nei tag; non è una semplice romanizzazione.
    
  },
  // Alias aggiuntivi fra la grafia Spotify e quella presente nella libreria.
  "ALIASES": {},
  // Gruppi di grafie che indicano lo stesso artista; la corrispondenza vale in entrambe le direzioni.
  "ARTIST_GROUPS": [
    // Alias dello stesso artista; non usarlo per artisti distinti che collaborano.
    [
      // Voce della lista di configurazione.
      
      // Voce della lista di configurazione.
     
    ],
   
  ],
  // Override per una riga: chiave artista - titolo, valore artista da usare per la ricerca.
  "FORCE_ARTIST": {},
  // Correzioni persistenti per riga CSV, indicizzate per playlist e artista - titolo.
  "CSV_FIX": {},
  // Parole letterali da convertire in emoji durante il matching di artista e titolo.
  "EMOJI_WORDS": {},
  // ID Spotify -> username Navidrome; serve per riconoscere il proprietario degli ZIP.
  "SPOTIFY_USERS": {},
  // Playlist da ignorare, separate per utente Navidrome; un asterisco finale indica un prefisso.
  "SKIP_PLAYLISTS": {
    // Username Navidrome -> playlist/prefissi da ignorare per quell’utente.
    "user": [
      // Voce della lista di configurazione.
      
    ]
  },
  // Nome playlist -> sottocartella sotto la directory Playlists.
  "PLAYLIST_FOLDERS": {},
  // Utenti per cui non avviare il fetch Exportify; gli ZIP/CSV gia’ presenti restano utilizzabili.
  "FETCH_IGNORED_USERS": [
    // Username escluso soltanto dal fetch; i CSV locali restano validi.
    "ignored_user"
  ],
  // Impostazioni per creare MP3 proxy Spotify Local Files senza modificare gli originali lossless.
  "SPOTIFY_LOCAL_PROXY": {
    // Abilita/disabilita la generazione e la scansione dei proxy.
    "enabled": true,
    // Directory di output MP3; deve restare fuori dalla libreria Navidrome.
    "output_dir": "~/Music/Spotify Local Files",
    // Bitrate MP3 dei proxy, da 32k a 320k; 32k mono massimizza il risparmio di spazio.
    "bitrate": "32k",
    // Numero di canali: 1=mono (file piu' piccoli), 2=stereo.
    "channels": 1,
    // Album proxy inseriti manualmente; non vengono rimossi dalla scansione automatica.
    "albums": [
      {
        // Copia MP3 dai FLAC locali per Spotify Local Files
        "artist": 
        "album": 
      }
    ],
    // Album non trovati su Spotify, gestiti da --sync-spotify-proxy-config.
    "auto_albums": [],
    // Mercato Spotify ISO a due lettere usato per le ricerche.
    "market": "IT",
    // Giorni di validità della cache di ricerca del catalogo Spotify; 0 forza nuove query.
    "catalog_cache_days": 90,
    // Utente Navidrome da cui leggere i preferiti; vuoto = utente predefinito.
    "favorites_user": ""
  }
}
